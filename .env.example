# Postgres de desarrollo (docker compose, puerto 5433)
DATABASE_URL=postgres://hylistats:hylistats@localhost:5433/hylistats
# Postgres de tests (BD separada; los tests nunca usan la de desarrollo)
DATABASE_URL_TEST=postgres://hylistats:hylistats@localhost:5433/hylistats_test
# Key de la Riot API (fallback si no hay key guardada en BD desde /admin); nunca commitear
RIOT_API_KEY=
# Token de operador para acceder a /admin
ADMIN_TOKEN=
# Inicio de la temporada (UTC) desde el que se cuentan las partidas de Arena (queue 1750)
SEASON_START=2026-05-12T00:00:00Z
# Arranca el worker de sincronización dentro del proceso de Next (false para desactivarlo)
WORKER_ENABLED=true
